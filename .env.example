# Local defaults. The API uses the same origin as the frontend.
PORT=4310
BIND_HOST=127.0.0.1
DB_PATH=./var/warehouse.db
# On Vercel use a separate Neon project and its pooled PostgreSQL connection string.
# DATABASE_URL=postgresql://USER:PASSWORD@HOST-pooler.REGION.aws.neon.tech/neondb?sslmode=verify-full
# DATABASE_URL is server-only. Never name it VITE_DATABASE_URL.
# For production, export NODE_ENV=production and set this to the exact HTTPS origin.
# PUBLIC_ORIGIN=https://warehouse.example.com
# npm start does not load this file automatically. Set environment variables in your service/container.
